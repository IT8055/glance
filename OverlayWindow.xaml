<Window x:Class="Glance.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Glance"
        Title="Glance"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#1FFFFFFF"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A full-width reading: label, value, and usually a bar. -->
        <DataTemplate x:Key="Row">
            <StackPanel Margin="0,0,0,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Margin="8,0,0,0"
                               Foreground="#FFFFFFFF" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Label}" Foreground="#E0FFFFFF" FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ProgressBar Style="{StaticResource Meter}" Margin="0,7,0,0"
                             Value="{Binding Percent, Mode=OneWay}" Foreground="{Binding BarBrush}"
                             Visibility="{Binding HasBar, Converter={StaticResource Vis}}"/>
                <TextBlock Text="{Binding Detail}" Margin="0,6,0,0" Foreground="#80FFFFFF" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasDetail, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- A compact reading. Two share a line. -->
        <DataTemplate x:Key="Tile">
            <DockPanel Margin="0,0,16,8">
                <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}" Margin="6,0,0,0"
                           Foreground="{Binding ValueBrush}" FontSize="12.5" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Label}" Foreground="#99FFFFFF" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:SectionViewModel}">
            <StackPanel>
                <DockPanel Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding UpdatedText}" Foreground="#66FFFFFF" FontSize="11"/>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Heading}" Foreground="#8CFFFFFF" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" Margin="8,0,8,0" Foreground="#73FFFFFF" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Row}" Focusable="False"/>
                <!-- The negative margin cancels the right-hand gap of the second tile on each line. -->
                <ItemsControl ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource Tile}" Focusable="False"
                              Margin="0,0,-16,4" Visibility="{Binding HasTiles, Converter={StaticResource Vis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock Text="{Binding Notice}" Margin="0,0,0,12" FontSize="11" TextWrapping="Wrap"
                           Foreground="{Binding NoticeBrush}"
                           Visibility="{Binding HasNotice, Converter={StaticResource Vis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- The settings button: invisible until the pointer is over the widget. -->
        <Style x:Key="GearButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Disc" Width="24" Height="24" CornerRadius="12" Background="#FF2A2D35">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#D9FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#FF3D4250"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, ElementName=Root}" Value="True">
                    <Setter Property="Opacity" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- The margin leaves room for the shadow. The shadow sits on its own layer so the text stays sharp. -->
    <Grid x:Name="Root" Margin="12" Background="Transparent">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Zoom"/>
        </Grid.LayoutTransform>
        <Border CornerRadius="14" Background="#FF14161B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5"/>
            </Border.Effect>
        </Border>
        <Border CornerRadius="14" Background="#FF14161B" BorderBrush="#2EFFFFFF" BorderThickness="1"
                Padding="16,14,16,4">
            <ItemsControl ItemsSource="{Binding Sections}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <local:ColumnsPanel Columns="{Binding Columns}" MaxColumnHeight="{Binding MaxColumnHeight}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
        <Button Style="{StaticResource GearButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                ToolTip="Settings" Click="OnGearClick"/>
    </Grid>
</Window>
